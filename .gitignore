# --- design assets: mockups and Stitch exports stay untracked ---
#
# Anchored with a leading slash. Unanchored, "dashboard/" matches a directory
# of that name at ANY depth, so it was also swallowing
# src/lib/features/dashboard/ -- a new file added there would have been
# silently invisible to git, the same failure the stale "src/" rule caused.
/public/
/dashboard/
/mobile/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- env / secrets ---
.env
.env.*
!.env.example
*.pem
*.p8
service-account*.json

# --- local media / scratch ---
server/media/
server/tmp/
*.db
*.sqlite3

# --- os / editor ---
.DS_Store
.idea/
.vscode/
