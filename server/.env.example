# ---- environment ----
ENV=dev                       # dev | staging | production
LOG_LEVEL=INFO

# ---- database ----
# local:  postgresql+psycopg://satya:satya@localhost:5432/satya
# neon :  postgresql+psycopg://USER:PASS@ep-xxx.neon.tech/satya?sslmode=require
DATABASE_URL=postgresql+psycopg://satya:satya@localhost:5432/satya

# ---- auth ----
JWT_SECRET=dev-only-change-me-32-bytes-minimum-secret
ACCESS_TOKEN_DAYS=30
REFRESH_TOKEN_DAYS=180

# ---- OTP delivery ----
# console = OTP is logged + echoed in the response. NOT a bypass: the code is
#           generated, hashed, expiry-bound and attempt-limited identically.
# msg91   = real SMS provider.
# ENV=production REFUSES TO BOOT with SMS_PROVIDER=console.
SMS_PROVIDER=console

# Only read when SMS_PROVIDER=msg91, and validated at boot: selecting msg91
# without these fails at startup rather than at an officer's first sign-in.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SATYA

# ---- demo ----
DEMO_MODE=true
DEMO_RESET_KEY=change-me

# ---- media ----
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=15000000

# ---- satellite ----
SATELLITE_ADAPTER=fixture     # fixture | bhuvan
