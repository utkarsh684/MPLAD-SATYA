# ---- environment ----
ENV=dev                       # dev | staging | production
LOG_LEVEL=INFO

# ---- database ----
# Paste the provider's connection string verbatim. A bare postgresql:// (or
# Heroku's postgres://) is upgraded to postgresql+psycopg:// automatically,
# because this project runs psycopg 3 and psycopg2 is not installed.
#
# local     : postgresql://satya:satya@localhost:5432/satya
# neon      : postgresql://USER:PASS@ep-xxx.neon.tech/satya?sslmode=require
# supabase  : use the SESSION POOLER (port 5432), not Direct.
#             Direct is IPv6-only and Render egresses over IPv4.
#             postgresql://postgres.<ref>:PASS@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://satya:satya@localhost:5432/satya

# Optional. Only needed if DATABASE_URL points at a TRANSACTION pooler
# (Supabase port 6543): DDL should not run through it. Leave blank for the
# session pooler, Neon, or a direct connection.
DATABASE_MIGRATION_URL=

# ---- auth ----
JWT_SECRET=dev-only-change-me-32-bytes-minimum-secret
ACCESS_TOKEN_DAYS=30
REFRESH_TOKEN_DAYS=180

# ---- OTP delivery ----
# console = OTP is logged + echoed in the response. NOT a bypass: the code is
#           generated, hashed, expiry-bound and attempt-limited identically.
# msg91   = real SMS provider.
# ENV=production REFUSES TO BOOT with SMS_PROVIDER=console.
SMS_PROVIDER=console

# Only read when SMS_PROVIDER=msg91, and validated at boot: selecting msg91
# without these fails at startup rather than at an officer's first sign-in.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SATYA

# ---- demo ----
DEMO_MODE=true
DEMO_RESET_KEY=change-me

# ---- media ----
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=15000000

# ---- satellite ----
SATELLITE_ADAPTER=fixture     # fixture | bhuvan
